#!/usr/bin/env bash
# lamp — start/stop LAMP projects in parallel. One shared MySQL, one web container per project.
set -uo pipefail
ROOT="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$ROOT" || exit 1
LEASE=/home/peralta/.local/bin/dev-services-lease

if docker compose version >/dev/null 2>&1; then
  DC=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
  DC=(docker-compose)
else
  echo "ERROR: neither 'docker compose' nor 'docker-compose' found" >&2; exit 1
fi

die() { echo "ERROR: $*" >&2; exit 1; }
lease() { [ -x "$LEASE" ] && "$LEASE" "$1" || echo "warn: $LEASE not found, skipping lease $1" >&2; }

list_projects() { for f in projects/*.env; do b=$(basename "$f" .env); echo "$b"; done; }

valid_project() {
  local p="${1:-}"
  if [ -z "$p" ] || [ ! -f "projects/$p.env" ]; then
    echo "ERROR: unknown project '${p}'. Valid projects:" >&2
    list_projects | sed 's/^/  /' >&2
    return 1
  fi
}

# load PROJECT_* vars of project $1 into this shell (+ shared .env)
load_project() {
  set -a; . ./.env; . "projects/$1.env"; set +a
  [ -d "$PROJECT_DIR" ] || die "project dir '$PROJECT_DIR' for '$1' does not exist"
}

# WRITABLE_DIRS (space-separated, relative to PROJECT_DIR).
# prepare_dirs: create on host before start (no root needed).
prepare_dirs() {
  local d
  for d in ${WRITABLE_DIRS:-}; do
    mkdir -p "$PROJECT_DIR/$d" || die "cannot create $PROJECT_DIR/$d"
  done
}

# fix_owner: after start, chown to www-data as root inside the container. Needed when a dir already
# exists owned by another uid (e.g. old uid 33) that the host user cannot chmod.
fix_owner() {
  local c=$1 d
  for d in ${WRITABLE_DIRS:-}; do
    docker exec -u root "$c" sh -c 'chown -R www-data:www-data "$1" && chmod -R u+rwX,g+rwX "$1"' _ "/var/www/html/$d" \
      || echo "warn: could not fix owner of $d in $c" >&2
  done
}

dc_shared()  { "${DC[@]}" -p lamp-shared --env-file .env -f compose.shared.yml "$@"; }
# Image choice: base lamp-web:<php> from bin/<php>; if projects/<name>.Dockerfile exists, a layer
# on top of the base (extra apt packages, php extensions...) tagged lamp-<name>:latest.
web_image_env() {
  local p=$1 php
  php=$(sed -n 's/^PHPVERSION=//p' "projects/$p.env" | tr -d '"')
  if [ -f "projects/$p.Dockerfile" ]; then
    export BUILD_CONTEXT=./projects BUILD_DOCKERFILE="$p.Dockerfile" WEB_IMAGE="lamp-$p:latest"
  else
    export BUILD_CONTEXT="./bin/$php" BUILD_DOCKERFILE=Dockerfile WEB_IMAGE="lamp-web:$php"
  fi
}

# project layers start FROM the base image, so make sure it exists/is current (cached = fast)
build_base() {
  local php
  php=$(sed -n 's/^PHPVERSION=//p' "projects/$1.env" | tr -d '"')
  if [ -f "projects/$1.Dockerfile" ]; then
    docker build -q -t "lamp-web:$php" "./bin/$php" >/dev/null
  fi
}

dc_project() { web_image_env "$1"; "${DC[@]}" -p "lamp-$1" --env-file .env --env-file "projects/$1.env" -f compose.project.yml "${@:2}"; }

# names of project web containers (without the lamp- prefix). $1=-a also counts created/exited.
# Fails (non-zero) if docker is unreachable, so callers never mistake an error for "none running".
running_projects() {
  local out
  out=$(docker ps ${1:-} --filter label=com.docker.compose.service=webserver --format '{{.Names}}') || return 1
  printf '%s\n' "$out" | sed -n 's/^lamp-//p' | sort
}

# stop shared stack only if docker answered AND no project container exists in any state
shared_down_if_idle() {
  local left
  left=$(running_projects -a) || { echo "warn: cannot query docker, leaving shared stack up" >&2; return 0; }
  [ -z "$left" ] && shared_down
  return 0
}

# one mutating lamp command at a time (up/down race on shared stack)
take_lock() { exec 9>"$ROOT/.lamp.lock"; flock 9; }

shared_up()   { dc_shared up -d --build --wait; }
shared_down() { dc_shared down; }

# docker turns a missing bind-mount source into an empty DIRECTORY, silently dropping php.ini.
# Refuse to start unless the shared config files really are files.
check_config() {
  local f
  for f in config/php/php.ini; do
    [ -f "$f" ] || die "$f is missing or not a file (docker would create a directory there). Fix: rmdir $f 2>/dev/null; git checkout $f"
  done
}

cmd_up() {
  check_config
  valid_project "${1:-}" || exit 1
  local p=$1
  ( load_project "$p" && prepare_dirs ) || exit 1
  lease cancel
  if ! shared_up; then
    shared_down_if_idle; [ -n "$(running_projects)" ] && lease arm
    die "shared stack failed to start"
  fi
  build_base "$p" || { shared_down_if_idle; die "base image build failed"; }
  if ! dc_project "$p" up -d --build; then
    dc_project "$p" down >/dev/null 2>&1
    shared_down_if_idle; [ -n "$(running_projects)" ] && lease arm
    die "project '$p' failed to start"
  fi
  ( load_project "$p" && fix_owner "lamp-$p" )
  lease arm
  ( load_project "$p"; echo "$p up: http://localhost:$HTTP_PORT  https://localhost:$HTTPS_PORT  (pma http://localhost:$HOST_MACHINE_PMA_PORT)" )
}

cmd_config() {
  valid_project "${1:-}" || exit 1
  ( load_project "$1" ) || exit 1
  dc_project "$1" config
}

# security updates: re-pull the floating php:<ver>-apache tag (newest patch), rebuild, restart project
cmd_rebuild() {
  valid_project "${1:-}" || exit 1
  local php
  ( load_project "$1" ) || exit 1
  php=$(sed -n 's/^PHPVERSION=//p' "projects/$1.env" | tr -d '"')
  [ -d "bin/$php" ] || die "no bin/$php (PHPVERSION in projects/$1.env)"
  docker build --pull -t "lamp-web:$php" "./bin/$php" || die "base rebuild failed"
  cmd_up "$1"
}

cmd_prep() {
  valid_project "${1:-}" || exit 1
  ( load_project "$1" && prepare_dirs )
}

cmd_down() {
  valid_project "${1:-}" || exit 1
  dc_project "$1" down
  shared_down_if_idle
}

cmd_down_all() {
  local p all
  all=$(running_projects -a) || die "cannot query docker"
  for p in $all; do
    if [ -f "projects/$p.env" ]; then dc_project "$p" down; else docker rm -f "lamp-$p" >/dev/null; fi
  done
  shared_down_if_idle
}

cmd_ls() {
  local p any=0
  for p in $(running_projects); do
    any=1
    ( load_project "$p" 2>/dev/null; printf '%-14s http://localhost:%s  https://localhost:%s\n' "$p" "${HTTP_PORT:-?}" "${HTTPS_PORT:-?}" )
  done
  [ $any -eq 0 ] && echo "no projects running"
  if docker ps --format '{{.Names}}' | grep -qx 'lamp-phpmyadmin'; then
    echo "shared: MySQL 127.0.0.1:3306, phpMyAdmin http://localhost:8080"
  else
    echo "shared: stopped"
  fi
  return 0
}

# first-run setup on a new machine: .env, ssl cert, data/log dirs, sanity checks
cmd_init() {
  local miss=0 p
  command -v docker >/dev/null || { echo "MISSING: docker"; miss=1; }
  "${DC[@]}" version >/dev/null 2>&1 || { echo "MISSING: docker compose"; miss=1; }
  for b in flock openssl; do command -v "$b" >/dev/null || { echo "MISSING: $b"; miss=1; }; done
  [ $miss -eq 0 ] || exit 1

  [ -f .env ] || { cp sample.env .env && echo "created .env from sample.env (edit passwords if needed)"; }
  mkdir -p data/mysql logs/mysql

  if [ -e config/php/php.ini ] && [ ! -f config/php/php.ini ]; then
    echo "WARN: config/php/php.ini is a directory (docker made it). Remove it: rmdir config/php/php.ini, then git checkout config/php/php.ini"
  fi

  if [ ! -f config/ssl/dev-selfsigned.crt ] || [ ! -f config/ssl/dev-selfsigned.key ]; then
    mkdir -p config/ssl
    openssl req -x509 -nodes -newkey rsa:2048 -days 825 -subj "/CN=localhost" \
      -addext "subjectAltName=DNS:localhost,DNS:*.localhost,IP:127.0.0.1" \
      -keyout config/ssl/dev-selfsigned.key -out config/ssl/dev-selfsigned.crt >/dev/null 2>&1 \
      || die "openssl failed to create the dev certificate"
    chmod 600 config/ssl/dev-selfsigned.key
    echo "created self-signed dev cert in config/ssl/"
  fi

  for p in $(list_projects); do
    ( set -a; . "projects/$p.env"; set +a
      [ -d "$PROJECT_DIR" ] && echo "ok       $p -> $PROJECT_DIR" || echo "MISSING  $p -> $PROJECT_DIR (clone/copy the project here)" )
  done
  echo "init done. Next: lamp up <project>"
}

usage() {
  cat <<USAGE
Usage: lamp <command> [project]
  up <p>        start project (and shared MySQL if needed)
  down <p>      stop project (stops MySQL when last project stops)
  restart <p>   down + up
  down-all      stop everything
  prep <p>      create project's WRITABLE_DIRS only (up does this too)
  config <p>    show resolved compose config (debug)
  init          first run on a new machine (.env, ssl cert, dirs, checks)
  rebuild <p>   pull newest PHP patch release and rebuild (security updates), then up
  ls            show running projects and URLs
  logs <p> [-f] container logs
  shell <p>     bash inside the project container
Projects:
$(list_projects | sed 's/^/  /')
USAGE
}

case "${1:-help}" in
  up|down|restart|down-all|rebuild) take_lock ;;
esac

case "${1:-help}" in
  up)       shift; cmd_up "${1:-}" ;;
  down)     shift; cmd_down "${1:-}" ;;
  restart)  shift; cmd_down "${1:-}" && cmd_up "${1:-}" ;;
  down-all) cmd_down_all ;;
  init)     cmd_init ;;
  rebuild)  shift; cmd_rebuild "${1:-}" ;;
  config)   shift; cmd_config "${1:-}" ;;
  prep)     shift; cmd_prep "${1:-}" ;;
  ls)       cmd_ls ;;
  logs)     shift; valid_project "${1:-}" || exit 1; p=$1; shift; docker logs "$@" "lamp-$p" ;;
  shell)    shift; valid_project "${1:-}" || exit 1; docker exec -it "lamp-$1" bash ;;
  help|-h|--help) usage ;;
  *)        usage >&2; exit 1 ;;
esac
